NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated allowlist. Defaults to CLIENT_ORIGIN if omitted.
# CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173
# Required for account features. Health still works without MongoDB.
# Reservation workflows require Atlas or a local replica set (rs0 in this example).
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge?replicaSet=rs0
JSON_BODY_LIMIT=100kb
# REQUIRED: replace with output of: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_SECONDS=86400
# lax/strict for same-site deployment; none requires production HTTPS.
COOKIE_SAME_SITE=lax
# Per IP, per 15 minutes. Use a shared store if deploying multiple API instances.
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=10
# Development-only bootstrap: set these locally, run bootstrap, then remove.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Optional Milestone 4 discovery/matching settings (no new secrets).
GEO_DEFAULT_RADIUS_KM=10
GEO_MAX_RADIUS_KM=100
MATCH_DISTANCE_WEIGHT=40
MATCH_QUANTITY_WEIGHT=35
MATCH_TIME_WEIGHT=25
MATCH_PICKUP_WINDOW_MINUTES=240

# Optional Milestone 5 uploads. Server only; obtain values from your Cloudinary console.
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_YOUR_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_YOUR_API_SECRET
