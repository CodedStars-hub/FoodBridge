NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:5173
# Optional comma-separated allowlist. Defaults to CLIENT_ORIGIN if omitted.
# CLIENT_ORIGINS=http://localhost:5173,http://localhost:4173
# Required for account features. Health still works without MongoDB.
# Reservation workflows require Atlas or a local replica set (rs0 in this example).
MONGODB_URI=mongodb://127.0.0.1:27017/foodbridge?replicaSet=rs0
JSON_BODY_LIMIT=100kb
# REQUIRED: replace with output of: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_SECONDS=86400
# lax/strict for same-site deployment; none requires production HTTPS.
COOKIE_SAME_SITE=lax
# Per normalized IP, per 15 minutes; socket-only demo mode shares each budget across all visitors.
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=10
# Empty for local/socket-only demo access. For proxy-aware Render mode, set only
# operator-verified inbound proxy IPs/CIDRs (not Render outbound IP ranges).
# Never use true, a hop count, 0.0.0.0/0, ::/0, or blanket private-network aliases.
# See docs/milestone-6b-hardening.md before configuring.
TRUSTED_PROXY_CIDRS=
# Local: express. Render demo: socket ignores ALL forwarded client IP headers.
CLIENT_IP_SOURCE=express
# Explicit restricted single-process Render demo (set these in Render, not locally):
# NODE_ENV=production
# CLIENT_IP_SOURCE=socket
# RATE_LIMIT_STORE=process-demo
# DEMO_SINGLE_PROCESS=true
# COOKIE_SAME_SITE=none
# CLIENT_ORIGIN=https://your-exact-vercel-project.vercel.app
# Leave TRUSTED_PROXY_CIDRS and Redis credentials empty for that demo mode.
RATE_LIMIT_STORE=auto
DEMO_SINGLE_PROCESS=false
# Development-only bootstrap: set these locally, run bootstrap, then remove.
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Optional Milestone 4 discovery/matching settings (no new secrets).
GEO_DEFAULT_RADIUS_KM=10
GEO_MAX_RADIUS_KM=100
MATCH_DISTANCE_WEIGHT=40
MATCH_QUANTITY_WEIGHT=35
MATCH_TIME_WEIGHT=25
MATCH_PICKUP_WINDOW_MINUTES=240

# Optional Milestone 5 uploads. Server only; obtain values from your Cloudinary console.
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_YOUR_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_YOUR_API_SECRET

# Optional shared Redis HTTPS counters. Required in production unless process-demo is explicitly selected;
# absent credentials or provider outage returns 503, never local fallback.
# Obtain these server-only values from a manually provisioned Upstash Redis database.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Stable across instances; use a different namespace for preview vs demo production.
RATE_LIMIT_NAMESPACE=foodbridge
