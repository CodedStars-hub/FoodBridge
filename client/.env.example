# Local Vite proxy: /api. On Vercel set VITE_API_URL=https://your-render-service.onrender.com/api.
# Never put credentials in VITE_* values; they are public.
VITE_API_URL=/api
# Optional OSM-compatible tile endpoint; maps only load after explicit user action.
# VITE_OSM_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
